import { defineConfig } from 'vitepress'
import { readdirSync, readFileSync } from 'node:fs'
import { join } from 'node:path'

// The site has three sections, each with its own sidebar: manual/ (the user's
// manual) and developer/ (the developer's corner) are plain Markdown pages;
// api/ (classes, structs and enumerations) is generated by moxygen and sorted
// out by fix_markdown.py. The sidebars are built from the files.
const docs = join(__dirname, '..')
const apiDir = join(docs, 'api')

// Color schemes. The scheme is selected at build time, e.g. "make SCHEME=nord".
// index.ts imports its stylesheet through the alias "@scheme"; the code blocks
// use the matching syntax highlighting themes.
const schemes: Record<string, { css: string, code: { light: string, dark: string } }> = {
  catppuccin: {
    css: join(docs, '..', 'node_modules/@catppuccin/vitepress/theme/mocha/mauve.css'),
    code: { light: 'catppuccin-latte', dark: 'catppuccin-mocha' },
  },
  dracula: {
    css: join(__dirname, 'theme/schemes/dracula.css'),
    code: { light: 'github-light', dark: 'dracula' },
  },
  nord: {
    css: join(__dirname, 'theme/schemes/nord.css'),
    code: { light: 'github-light', dark: 'nord' },
  },
  'tokyo-night': {
    css: join(__dirname, 'theme/schemes/tokyo-night.css'),
    code: { light: 'github-light', dark: 'tokyo-night' },
  },
}
const schemeName = process.env.SCHEME || 'tokyo-night'
const scheme = schemes[schemeName]
if (!scheme) {
  throw new Error(`Unknown SCHEME '${schemeName}'. Choose one of: ${Object.keys(schemes).join(', ')}`)
}

// The pages of the manual and the developer's corner, in the order of the sidebar
const manual: { text: string, items: Entry[] }[] = [
  { text: 'Overview', items: ['Overview/About'] },
  { text: 'Tutorials', items: ['Tutorials/GettingStarted', 'Tutorials/Exploring'] },
  { text: 'How-to guides', items: ['HowTo/MappingCmd', 'HowTo/NullModemCable'] },
  { text: 'References', items: [
    { text: 'Emulator Settings', items: ['References/Preferences/index', 'References/Preferences/General',
      'References/Preferences/Controls', 'References/Preferences/Devices'] },
    { text: 'Virtual Machine Settings', items: ['References/Configuration/index', 'References/Configuration/Roms',
      'References/Configuration/Chipset', 'References/Configuration/Memory',
      'References/Configuration/Peripherals', 'References/Configuration/Compatibility',
      'References/Configuration/Audio', 'References/Configuration/Video'] },
    'References/FileFormats',
  ] },
]
const developer = ['ClassHierarchy', 'ThreadClass', 'MessageQueue', 'RunLoop', 'EventScheduler', 'SuperHires']

// The title of a page: its first heading
function title(path: string): string {
  const text = readFileSync(join(docs, `${path}.md`), 'utf8')
  return /^# (.+?)\s*$/m.exec(text)?.[1] ?? path
}

type Entry = string | { text: string, items: Entry[] }

function sidebarItems(section: string, entries: Entry[]): any[] {
  return entries.map(e => typeof e === 'string'
    ? { text: title(`${section}/${e}`), link: `/${section}/${e}` }
    : { text: e.text, collapsed: true, items: sidebarItems(section, e.items) })
}

function apiFiles(): string[] {
  return readdirSync(apiDir).filter(f => f.endsWith('.md'))
}

// The API classes in the order of the API overview; other *API classes follow
const apis = ['VAmiga', 'API', 'AmigaAPI', 'AgnusAPI', 'CopperAPI', 'BlitterAPI', 'XRayAPI',
              'LogicAnalyzerAPI', 'CIAAPI', 'CPUAPI', 'CPUDebuggerAPI', 'GuardsAPI', 'DeniseAPI',
              'MemoryAPI', 'MemoryDebuggerAPI', 'PaulaAPI', 'DiskControllerAPI', 'UARTAPI', 'RTCAPI',
              'AudioPortAPI', 'VideoPortAPI', 'ControlPortAPI', 'JoystickAPI', 'MouseAPI',
              'SerialPortAPI', 'FloppyDriveAPI', 'HardDriveAPI', 'HdControllerAPI', 'KeyboardAPI',
              'MsgQueueAPI', 'RemoteManagerAPI', 'RetroShellAPI', 'DefaultsAPI']

// Structs and unions, grouped by what they are for. The first matching rule
// decides; the errors are listed under More instead.
const structKinds: [string, RegExp][] = [
  ['Configuration', /Config$/],
  ['Info', /Info$/],
  ['Metrics', /(Metrics|Stats)$/],
  ['Commands', /(Cmd|^Command)$/],
  ['Messages', /(Msg|^Message)$/],
  ['Traits', /Traits$/],
  ['Other', /./],
]

function structGroups() {
  const errors = ['CoreError', 'MediaError']
  const structs = apiFiles().filter(f => /^vamiga-/.test(f))
    .filter(f => /^kind:\s*(struct|union)\s*$/m.test(readFileSync(join(apiDir, f), 'utf8')))
    .map(f => f.replace(/^vamiga-|\.md$/g, ''))
    .filter(c => !errors.includes(c))
    .sort((a, b) => a.localeCompare(b))
  const groups = new Map(structKinds.map(([label]) => [label, [] as string[]]))
  for (const c of structs) groups.get(structKinds.find(([, re]) => re.test(c))![0])!.push(c)
  return [...groups].filter(([, list]) => list.length)
    .map(([label, list]) => ({
      text: label,
      collapsed: true,
      items: list.map(c => ({ text: c, link: `/api/vamiga-${c}` })),
    }))
}

function enumItems() {
  return apiFiles().filter(f => f.startsWith('enum-'))
    .map(f => f.replace(/^enum-|\.md$/g, ''))
    .sort((a, b) => a.localeCompare(b))
    .map(e => ({ text: e, link: `/api/enum-${e}` }))
}

function apiItems() {
  const classes = apiFiles().filter(f => /^vamiga-/.test(f))
    .map(f => f.replace(/^vamiga-|\.md$/g, ''))
    .filter(c => c.endsWith('API') || c === 'vAmiga')
  const rank = (c: string) => { const i = apis.indexOf(c); return i < 0 ? apis.length : i }
  return classes.sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
    .map(c => ({ text: c, link: `/api/vamiga-${c}` }))
}

export default defineConfig({
  title: 'vAmiga',
  description: 'Manual and API reference of the vAmiga emulator',
  lang: 'en-US',
  // The published site lives in a subfolder (see "make publish")
  base: process.env.BASE || '/',
  cleanUrls: true,
  outDir: '../build/site',
  markdown: { theme: scheme.code },
  vite: { resolve: { alias: { '@scheme': scheme.css } } },
  themeConfig: {
    logo: '/icon.png',
    search: { provider: 'local' },
    nav: [
      { text: 'Manual', link: '/manual/Overview/About', activeMatch: '^/manual/' },
      { text: 'Developer', link: '/developer/ClassHierarchy', activeMatch: '^/developer/' },
      { text: 'API', link: '/api/overview', activeMatch: '^/api/' },
    ],
    sidebar: {
      '/manual/': [
        { text: "vAmiga User's Manual", items: manual.map(g => ({ text: g.text, collapsed: false, items: sidebarItems('manual', g.items) })) },
      ],
      '/developer/': [
        { text: "Developer's Corner", collapsed: false, items: sidebarItems('developer', developer) },
      ],
      '/api/': [
        { text: 'API', collapsed: false, items: [{ text: 'Overview', link: '/api/overview' }, ...apiItems()] },
        { text: 'Structs', collapsed: true, items: structGroups() },
        { text: 'Enumerations', collapsed: true, items: enumItems() },
        { text: 'More', collapsed: false, items: [
          { text: 'Types and Enumerations', link: '/api/vamiga' },
          { text: 'CoreError', link: '/api/vamiga-CoreError' },
          { text: 'MediaError', link: '/api/vamiga-MediaError' },
          { text: 'IOError', link: '/api/utl-IOError' },
          { text: 'AnyFile', link: '/api/vamiga-AnyFile' },
          { text: 'Snapshot', link: '/api/vamiga-Snapshot' },
        ] },
      ],
    },
  },
})
